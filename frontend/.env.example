# ==============================================================
# Success MP Online — Frontend Environment Variables
# ==============================================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env to Git. It is listed in .gitignore.
#
# IMPORTANT: Only VITE_* variables are exposed to the browser bundle.
# NEVER put any secret key here (JWT secrets, API keys, DB passwords).
# ==============================================================

# ── BACKEND API ───────────────────────────────────────────────
# VITE_API_URL is the SINGLE source of truth for all API calls.
# Every frontend module (auth, payments, uploads, etc.) reads this one variable.
#
# Local development:
VITE_API_URL=http://localhost:3000/api/v1
#
# Production (Railway / Render / VPS) — uncomment and set your deployed URL:
# VITE_API_URL=https://your-backend-railway-domain.up.railway.app/api/v1
#
# NOTE: If VITE_API_URL is not set in a production build, the app will throw
# an error at startup instead of silently calling localhost.

# ── WHATSAPP CONTACT ──────────────────────────────────────────
# Country code + number (no + or spaces)
VITE_WHATSAPP_NUMBER=919479336535
