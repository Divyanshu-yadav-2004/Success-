# ==============================================================
# Success MP Online — Backend Environment Variables
# ==============================================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env to Git. It is listed in .gitignore.
# ==============================================================

# ── DATABASE ─────────────────────────────────────────────────
# Standard PostgreSQL connection string.
# Local development: postgresql://postgres:password@localhost:5432/successmponline
# Production (Neon): postgresql://[user]:[password]@[neon-hostname]/[dbname]?sslmode=require
DATABASE_URL=postgresql://postgres:password@localhost:5432/successmponline

# ── JWT ───────────────────────────────────────────────────────
# Use strong random strings (min 48 chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── GOOGLE OAUTH ──────────────────────────────────────────────
# Get from: https://console.cloud.google.com → APIs & Services → Credentials
# Authorized redirect URIs must include:
#   - http://localhost:3000/api/v1/auth/google/callback  (dev)
#   - https://YOUR-RAILWAY-DOMAIN/api/v1/auth/google/callback  (prod)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# ── AI ASSISTANT (GOOGLE GEMINI) ─────────────────────────────
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ── RAZORPAY ─────────────────────────────────────────────────
# Get from: https://dashboard.razorpay.com → Settings → API Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── FILE STORAGE (Optional — S3-compatible) ───────────────────
# Use any S3-compatible provider: MinIO, Backblaze B2, Cloudflare R2, AWS S3
# Leave blank to store file keys only in DB (files stored in memory/temp)
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=application-documents

# ── WHATSAPP ─────────────────────────────────────────────────
# Get from: Meta Business → WhatsApp → API Setup
WHATSAPP_API_URL=https://graph.facebook.com/v18.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ── EMAIL (RECOMMENDED FOR RAILWAY: RESEND HTTPS API) ─────────
# Railway blocks outbound direct SMTP (ports 25, 465, and 587) on standard plans.
# Resend dispatches emails via REST API over port 443 (standard HTTPS — never blocked).
# Get free API key (3,000 emails/mo) at: https://resend.com
RESEND_API_KEY=
# Verified custom sender on Resend (defaults to Success MP Online <noreply@successmponline.in>):
RESEND_FROM=Success MP Online <noreply@successmponline.in>

# ── EMAIL (SMTP FALLBACK) ────────────────────────────────────
# Used when RESEND_API_KEY is not set (e.g. local development or hosting with open SMTP ports)
# For Gmail: host=smtp.gmail.com, port=587, user=your@gmail.com, password=your-16-char-app-password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
# Optional: sender display name. Defaults to: Success MP Online <EMAIL_USER>
EMAIL_FROM=Success MP Online <helpSuccessMPonline@gmail.com>
# Optional HTTPS CDN URL for the email logo. When blank, the welcome email uses
# its embedded PNG logo (CID), which renders reliably in Gmail and Outlook.
EMAIL_LOGO_URL=
SUPPORT_EMAIL=helpSuccessMPonline@gmail.com
SUPPORT_PHONE=7415921990

# ── SERVER ───────────────────────────────────────────────────
# FRONTEND_URL: used for CORS, Google OAuth redirect, and email links
# Local:
FRONTEND_URL=http://localhost:5173
# Production (Railway):
# FRONTEND_URL=https://your-frontend-domain.railway.app
PORT=3000

# ── SEED ─────────────────────────────────────────────────────
# First admin account credentials (used only during seed)
ADMIN_INITIAL_EMAIL=admin@successmponline.in
ADMIN_INITIAL_PASSWORD=
